{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node ../../scripts/start-mobile.mjs",
    "android": "node ../../scripts/start-mobile.mjs --android",
    "ios": "node ../../scripts/start-mobile.mjs --ios",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform android --platform ios",
    "web": "node ../../scripts/start-mobile.mjs --web --port 8083",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-sans-jp": "^0.4.3",
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.20",
    "expo-camera": "~57.0.4",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
