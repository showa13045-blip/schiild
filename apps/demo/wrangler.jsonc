{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"schiild-demo-api",
 "main":"cloudflare/worker.mjs",
 "compatibility_date":"2026-10-08",
 "compatibility_flags":["nodejs_compat"],
 "workers_dev":true,
 "vars":{"ALLOWED_ORIGINS":"https://schiild.pickleballnavi.jp","XSERVER_STORAGE_URL":"https://schiild.pickleballnavi.jp/storage.php"},
 "durable_objects":{"bindings":[{"name":"ATELIERS","class_name":"AtelierDirectory"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["AtelierDirectory"]}],
 "ratelimits":[{"name":"RATE_LIMITER","namespace_id":"1001","simple":{"limit":120,"period":60}},{"name":"AUTH_RATE_LIMITER","namespace_id":"1002","simple":{"limit":10,"period":60}}],
 "observability":{"enabled":false}
}
