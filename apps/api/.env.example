# Configure in your environment or in apps/api/.env (ignored by Git).
# Never commit actual credentials. Use a runtime DB login granted schiild_app.
DATABASE_URL=
REDIS_URL=
S3_BUCKET=
AWS_REGION=ap-northeast-1
GOOGLE_CLOUD_PROJECT=
# Firebase and AWS use their standard credential chains; keys are not copied here.
GEN_EXECUTABLE=
GEN_WASM=
GEN_PALETTE=
# HTTPS moderation gateway implementing MODERATION.md, not an arbitrary vendor URL.
MODERATION_URL=
MODERATION_TOKEN=
PORT=3000
HOST=127.0.0.1
